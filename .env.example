# ============================================
# FLa Vault Project - Environment Variables
# Copy file ini menjadi .env lalu isi nilainya
# ============================================

# --- Google Cloud OAuth 2.0 Client IDs ---
# Buat di https://console.cloud.google.com/apis/credentials
# Panduan lengkap ada di README.md bagian "Setup Google Cloud"

# OAuth Client type "Web application" (WAJIB - dipakai untuk Google Drive API)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# OAuth Client type "Android" (untuk production build Android)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# OAuth Client type "iOS" (untuk production build iOS)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
